{
  "_comment": "TU-8 矛盾检测词表 — 可运行时编辑，下次初始化生效",
  "_version": "1.0",
  "_usage": "加载时会合并（union）到 ContradictionDetector 的硬编码默认词表",

  "NEG": [
    "不", "没", "无", "别", "禁止", "不是", "从未", "难以", "无法", "失败",
    "错了", "不行", "不好", "不要", "拒绝", "取消", "关闭", "停止", "删除"
  ],
  "POS": [
    "是", "有", "会", "要", "可以", "确认", "对", "是的", "成功", "能够", "好",
    "没错", "当然", "必须", "一定", "同意", "继续", "开始", "启动", "开启"
  ],
  "QUERY": [
    "为什么", "怎么", "如何", "什么", "是不是", "能不能", "吗", "呢",
    "能不能", "可不可以", "是否", "啥"
  ]
}
